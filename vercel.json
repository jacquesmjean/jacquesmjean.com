{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/about",          "destination": "/#story",     "statusCode": 301 },
    { "source": "/about/",         "destination": "/#story",     "statusCode": 301 },
    { "source": "/advisory",       "destination": "/#techfides", "statusCode": 301 },
    { "source": "/advisory/",      "destination": "/#techfides", "statusCode": 301 },
    { "source": "/governance",     "destination": "/#work",      "statusCode": 301 },
    { "source": "/governance/",    "destination": "/#work",      "statusCode": 301 },
    { "source": "/contact",        "destination": "/#contact",   "statusCode": 301 },
    { "source": "/contact/",       "destination": "/#contact",   "statusCode": 301 },
    { "source": "/perspectives",   "destination": "/",           "statusCode": 301 },
    { "source": "/perspectives/",  "destination": "/",           "statusCode": 301 },
    { "source": "/perspectives/:slug*", "destination": "/",      "statusCode": 301 },
    { "source": "/white-paper",    "destination": "/",           "statusCode": 301 },
    { "source": "/white-paper/",   "destination": "/",           "statusCode": 301 },
    { "source": "/blog",           "destination": "/",           "statusCode": 301 },
    { "source": "/blog/:slug*",    "destination": "/",           "statusCode": 301 }
  ]
}
